using Gtk 4.0;
using Adw 1;

// Progress of a device operation (reset configuration).
template $ProgressDialog: Adw.Dialog {
  content-width: 420;
  can-close: false;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-end-title-buttons: false;
    }

    content: Gtk.Box {
      orientation: vertical;
      spacing: 24;
      margin-top: 12;
      margin-bottom: 24;
      margin-start: 24;
      margin-end: 24;

      Gtk.Label message {
        wrap: true;
        justify: center;
      }

      Gtk.Stack stack {
        Gtk.StackPage {
          name: "progress";

          child: Gtk.ProgressBar progress {
            valign: center;
          };
        }

        Gtk.StackPage {
          name: "done";

          child: Gtk.Button {
            label: _("_Close");
            use-underline: true;
            halign: center;
            clicked => $on_close();

            styles [
              "pill",
            ]
          };
        }
      }
    };
  };
}
